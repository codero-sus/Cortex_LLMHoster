# Cortex LLMHoster local Python interpreter override.
# Copy this file to .env, then replace the example with an executable path.
# This is a local filesystem setting; keep actual secrets out of this sample.
# Examples:
#   Linux/macOS: /opt/portable-python/bin/python3
#   Windows:     C:\Python312\python.exe
2PY2=/absolute/path/to/python

# Optional additional roots for the Models file picker (use the OS path separator).
# CORTEX_MODELS_DIR=/path/to/models:/another/local/models

# Required when authentication is enabled. This local key also signs account
# session cookies; it is not a cloud/provider credential. Generate a random value.
# CORTEX_API_KEY=replace-with-a-random-local-key

# Optional single local dashboard account. Set both alongside CORTEX_API_KEY
# to enable username/password sign-in in addition to bearer-key authentication.
# CORTEX_ADMIN_USERNAME=admin
# CORTEX_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional keyless mode: with this set to false, no dashboard/API authentication
# or CORTEX_API_KEY is required. Use only on a trusted local listener.
# CORTEX_API_AUTH_ENABLED=false
